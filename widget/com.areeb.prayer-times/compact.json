{
  "$schema": "../repo/community-sdk/schemas/layout-v1.schema.json",
  "type": "card",
  "width": 124,
  "height": 40,
  "padding": {
    "left": 6,
    "top": 3,
    "right": 6,
    "bottom": 3
  },
  "radius": 8,
  "backgroundColor": "#00000000",
  "children": [
    {
      "type": "column",
      "gap": 0,
      "children": [
        {
          "type": "text",
          "bind": "data.line1",
          "width": 112,
          "height": 16,
          "fontSize": 12,
          "fontWeight": "semibold",
          "trimming": "characterEllipsis",
          "color": "#FFFFFFFF"
        },
        {
          "type": "text",
          "bind": "data.line2",
          "width": 112,
          "height": 15,
          "fontSize": 11,
          "trimming": "characterEllipsis",
          "color": {
            "bind": "data.accent",
            "fallback": "#FF34D399"
          }
        },
        {
          "type": "spacer",
          "width": 1,
          "height": 2
        },
        {
          "type": "progress",
          "value": {
            "bind": "data.progress"
          },
          "width": 112,
          "height": 3,
          "color": {
            "bind": "data.accent",
            "fallback": "#FF34D399"
          }
        }
      ]
    }
  ]
}