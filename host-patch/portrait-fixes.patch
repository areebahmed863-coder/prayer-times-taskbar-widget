+// Several taskbars (landscape primary, portrait secondary) can live on the same
+// XAML thread, so a thread-based lookup always returns the same window and the
+// other taskbars receive the wrong button rectangles. Identify the taskbar that
+// owns this widget root by matching the width of its XAML tree to each window.
+HWND FindTaskbarWindowForRoot(wux::UIElement const& root) {
+    HWND fallback = FindCurrentProcessTaskbarWindow();
+    try {
+        double target = 0.0;
+        wux::DependencyObject node = root.try_as<wux::DependencyObject>();
+        for (int depth = 0; node && depth < 64; ++depth) {
+            if (auto element = node.try_as<wux::FrameworkElement>()) {
+                target = std::max(target, element.ActualWidth());
+            }
+            node = wuxm::VisualTreeHelper::GetParent(node);
+        }
+        if (target < 10.0) {
+            return fallback;
+        }
+
+        HWND best = nullptr;
+        double bestDiff = 8.0;
+        size_t candidates = 0;
+        for (HWND taskbar : EnumerateTaskbarWindowsForUia()) {
+            RECT rect{};
+            if (!GetWindowRect(taskbar, &rect)) continue;
+            ++candidates;
+            const double scale =
+                static_cast<double>(GetDpiForWindow(taskbar)) / 96.0;
+            const double width = (rect.right - rect.left) / scale;
+            const double diff = std::fabs(width - target);
+            if (diff < bestDiff) {
+                bestDiff = diff;
+                best = taskbar;
+            }
+        }
+        if (best) {
+            static thread_local std::vector<HWND> logged;
+            if (std::find(logged.begin(), logged.end(), best) == logged.end()) {
+                logged.push_back(best);
+                Wh_Log(L"Widget root matched taskbar %08X (tree width %.0f, %zu taskbars, fallback %08X)",
+                       static_cast<DWORD>(reinterpret_cast<ULONG_PTR>(best)),
+                       target, candidates,
+                       static_cast<DWORD>(reinterpret_cast<ULONG_PTR>(fallback)));
+            }
+            return best;
+        }
+    } catch (...) {
+    }
+    return fallback;
+}
